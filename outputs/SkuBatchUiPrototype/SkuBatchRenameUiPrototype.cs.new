            BorderThickness = new Thickness(0),
            FontSize = 16,
            FontWeight = FontWeights.Bold,
            Cursor = Cursors.Hand,
            Template = ButtonTemplate(18)
        };
        button.Effect = Shadow(16, 2, 0.04);
        return button;
    }

